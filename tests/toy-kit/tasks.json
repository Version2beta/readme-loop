   "expect": [
    "^--- PASS: TestRun \\(.*\\)$"
   ]
  },
  {
   "id": "T5",
   "title": "Whole tree: formatted, vetted, all tests green",
   "test": "test -z \"$(gofmt -l .)\" && go vet ./... && go test -v ./... -count=1",
   "tier": "normal",
   "expect": [
    "^--- PASS: TestSlugify \\(.*\\)$",
    "^--- PASS: TestWrapRejectsBadWidth \\(.*\\)$",
