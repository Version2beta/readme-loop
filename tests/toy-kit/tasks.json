    "^--- PASS: TestWrapRejectsBadWidth \\(.*\\)$"
   ]
  },
  {
   "id": "T3",
   "title": "Wrap builds lines",
   "test": "go test -v ./wrap -run '^TestWrapLines$' -count=1",
   "tier": "normal",
   "expect": [
    "^--- PASS: TestWrapLines \\(.*\\)$"
   ]
  },
  {
   "id": "T4",
   "title": "toy command",
